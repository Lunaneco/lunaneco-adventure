{
  "name": "lunaneco-adventure",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "audit:browser": "node tests/browser-audit.mjs",
    "audit:production": "node tests/production-audit.mjs",
    "dev:lan": "vite --host 0.0.0.0",
    "preview:lan": "vite preview --host 0.0.0.0",
    "build:pages": "vite build --base=/lunaneco-adventure/ --outDir=dist-pages",
    "preview:pages": "vite preview --base=/lunaneco-adventure/ --outDir=dist-pages",
    "audit:pages-build": "node tests/pages-build-audit.mjs",
    "audit:model-cache": "node tests/model-cache-audit.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
